# Copy to .env. The CLI loads it automatically; exported shell variables take precedence.
# off: local parsing only; live: real extraction; cache: explicit offline fixture mode.
LLM_MODE=live
# Built-in: openai or anthropic. Custom adapter: your_package.module:factory
LLM_PROVIDER=openai
# Select a model supported by your provider/account.
LLM_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
INVOICEDESK_DB=data/local-preview.sqlite3

# Shared logging: rotating app.log plus terminal output by default.
LOGGING_DIR=logs/
LOGGING_LIMIT_DAYS=1
LOG_TO_CONSOLE=true

OPENAI_API_KEY=
